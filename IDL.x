struct valores{
    float num1;
    float num2;
    char operation;
};

/*Programa, versión y definición de procedimiento*/

program CALCULADORA{
    version CALCULADORA_VERS{
        float ADD(valores)=1;
        float SUB(valores)=2;
	    float MUL(valores)=3;
	    float DIV(valores)=4;
    } = 6;
} = 456123789;
